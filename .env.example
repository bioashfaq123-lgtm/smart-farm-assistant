# Copy to .env.local for local testing with "npx vercel dev", and add these in Vercel Project Settings.
# NEVER commit .env or .env.local to git.

# AI & Data APIs
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DATA_GOV_API_KEY=

# Firebase Admin SDK (Server-Side)
# Paste service account JSON as a single-line string OR base64 encoded JSON
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=

# Razorpay Payment Gateway (Test keys start with rzp_test_, Live with rzp_live_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Subscription Configuration & Rules
PLAN_PRICE_PAISE=49900
PLAN_MONTHS=6
TRIAL_DAYS=14

# Access Control & Demo Modes
ADMIN_EMAIL=
DEMO_EMAILS=
DEMO_MODE_PUBLIC=false
